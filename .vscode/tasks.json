{
    "version": "2.0.0",
    "tasks": [
        {
            // Stop with Ctrl+C in its terminal so the emulator data is saved
            "label": "Firebase emulators: start",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\start-emulators.ps1"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "Firebase emulators: seed lots",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\seed-emulators.ps1"],
            "problemMatcher": [],
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "Android emulator: start sps_test",
            "type": "process",
            "command": "${env:LOCALAPPDATA}\\Android\\Sdk\\emulator\\emulator.exe",
            "args": ["-avd", "sps_test"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "silent" }
        }
    ]
}
