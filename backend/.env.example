# Copy to backend/.env. Local environment variables take precedence.
DEBUG=false
# PayHere sandbox merchant account only. Blank keys select a labelled mock session.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public HTTPS tunnel origin, without /api/v1 (required with PayHere keys).
PUBLIC_BASE_URL=
# Stripe test mode only; sk_live_ is rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
# Optional explicit test conversion; e.g. team-approved USD per 1 LKR.
# Blank means no automatic USD fallback. Never relabel LKR as USD.
STRIPE_USD_PER_LKR=

# Optional absolute SQLite file path; default is backend/.data/billing.sqlite3.
# BILLING_DB_PATH=/absolute/path/billing.sqlite3
# Shared only with the barrier backend, never included in the mobile app.
BARRIER_INTEGRATION_KEY=
