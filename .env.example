# ==============================================================================
# Smart Parking System (SPS) — Environment Template (J26-IT-335)
# Copy this file to .env and adjust values for your local setup or hardware.
# ==============================================================================

# 1. Firebase Environment & Project Configuration
ENVIRONMENT=dev
FIREBASE_PROJECT_ID=sps-app-c3f90
FIREBASE_DEV_PROJECT_ID=sps-app-dev
FIREBASE_REGION=us-central1

# 2. Local Firebase Emulator Configuration
USE_FIREBASE_EMULATOR=true
EMULATOR_HOST=127.0.0.1
ANDROID_EMULATOR_HOST=10.0.2.2
FIRESTORE_EMULATOR_PORT=8080
FUNCTIONS_EMULATOR_PORT=5001
AUTH_EMULATOR_PORT=9099
FIREBASE_UI_PORT=4000

# 3. Cloud Functions Base URLs
FUNCTIONS_BASE_URL_LOCAL=http://127.0.0.1:5001/sps-android/us-central1
FUNCTIONS_BASE_URL_ANDROID=http://10.0.2.2:5001/sps-android/us-central1
FUNCTIONS_BASE_URL_PROD=https://us-central1-sps-app-c3f90.cloudfunctions.net
FUNCTIONS_BASE_URL=http://127.0.0.1:5001/sps-android/us-central1

# 4. Subsystem Hardware & Integration API Keys
# Subsystem 1: CCTV Vision Occupancy (Samudi) -> Header: X-Camera-Api-Key
CCTV_DEVICE_ID=cam-lot-main-01
CCTV_API_KEY=cctv-secret-key-cam-01
CCTV_LOT_ID=lot-main

# Subsystem 2: IoT Barrier Gate QR Scanner (Varunprasath) -> Header: X-Device-Api-Key
BARRIER_DEVICE_ID=barrier-gate-entry-01
BARRIER_API_KEY=barrier-secret-key-gate-01
BARRIER_LOT_ID=lot-main

# Subsystem 3: Smart Billing & Payment (Rathnayake) -> Header: X-Service-Api-Key
PAYMENT_SERVICE_ID=payment-gateway-svc-01
PAYMENT_API_KEY=payment-secret-key-svc-01

# 5. Server Cryptographic Secrets (Cloud Functions only)
HMAC_SECRET_KEY=sps_research_hmac_secret_2026

# 6. Flutter Client App Flags
DEMO_MODE=true

# 7. Optional Third-Party Map / Routing API Keys
MAPTILER_API_KEY=
GOOGLE_ROUTES_API_KEY=
